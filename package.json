{
  "name": "insight-to-post",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:config": "node scripts/configure.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:ui:social": "node scripts/verify-ui-social.mjs",
    "test:ui:answer": "tsx scripts/verify-ui-answer.mjs",
    "verify:live": "tsx --env-file=.env.local scripts/verify-live.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "twitter-text": "^3.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/twitter-text": "^3.1.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
