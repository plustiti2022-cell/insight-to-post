QWEN_API_KEY=your-api-key
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
# 报告首次生成和校验后重生成使用独立模型
QWEN_REPORT_MODEL=qwen3.8-max
# 独立的流式开场模型，不影响后续研究模型
QWEN_OPENING_MODEL=qwen3.8-flash
# 单次模型调用超时（毫秒），报告与文案均含校验节点
QWEN_TIMEOUT_MS=150000
TAVILY_API_KEY=your-tavily-key
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_MS=60000
MINIMAX_API_KEY=your-minimax-key
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_TIMEOUT_MS=120000
# X 加权长度：普通帖默认 280，中文通常计为 2；支持长帖的账号可自行调整
X_TARGET_LENGTH=280
# 可选：独立的文案重试签名密钥；缺失时使用服务器千问密钥签名
# SOCIAL_SNAPSHOT_SECRET=your-random-server-secret
